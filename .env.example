# Never put the service role key in NEXT_PUBLIC variables.
NEXT_PUBLIC_SUPABASE_URL=https://khymrdteeedsrcbrbmul.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Exact public origin, without trailing slash.
APP_URL=http://localhost:3000

# Production submissions require Cloudflare Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Generate independent random secrets, at least 32 characters each.
RATE_LIMIT_SECRET=
CRON_SECRET=

# Verified sending domain. Recipients are configured in the staff dashboard.
RESEND_API_KEY=
EMAIL_FROM=

# Allow only local development to submit without Turnstile.
# Must be false/unset in production.
ALLOW_LOCAL_SUBMISSIONS=false

# Enable only after migrations, Auth email confirmation, SMTP and Auth CAPTCHA are configured.
CUSTOMER_AUTH_ENABLED=false

# Official WhatsApp Business Platform; all values are server-only.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
